#!/bin/bash
# Run a command on the Jetson over SSH.
# Since the board joined Wi-Fi (192.168.1.x) WSL reaches it directly through
# NAT; the old Windows-OpenSSH hop was only needed for link-local addressing.
JETSON_IP="${JETSON_IP:-192.168.1.181}"
KEY="${JETSON_KEY:-$HOME/.ssh/jetson_ed25519}"
exec ssh -i "$KEY" \
  -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
  -o BatchMode=yes -o ConnectTimeout=20 -o LogLevel=ERROR \
  jetson@"$JETSON_IP" "$@"
