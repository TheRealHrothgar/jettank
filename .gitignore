__pycache__/
*.pyc
.venv/
*.log

# Never commit: API keys, biometric data, TTS voice models (61MB each)
.env
*.env
!.env.example
.jettank.env
*_faces.json
voices/

# Photos of the robot in situ: they show the family's home and the people in
# it. Hank uses them locally for self-recognition; they do not get published.
*.JPEG
*.jpeg
*.JPG
*.jpg
*.HEIC

# Windows NTFS alternate-data-stream sidecars that ride along through WSL
# (Zone.Identifier, endpoint-DLP tags). Never ours to publish.
*:Zone.Identifier
*:sec.endpointdlp
*:*
